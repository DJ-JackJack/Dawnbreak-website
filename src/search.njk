---
layout: base
title: Search
permalink: /search/
---
<div class="wrap">
  <header class="page-head">
    <h1 class="page-title">Search</h1>
    <p class="page-lead">
      Across all {{ collections.allArticles.length }} article{% if collections.allArticles.length != 1 %}s{% endif %}.
    </p>
  </header>

  <div id="search" class="pagefind-search"></div>
  <noscript>
    <p class="entry-empty">
      Search needs JavaScript. <a href="/articles/">Browse the record instead →</a>
    </p>
  </noscript>
</div>

{% block scripts %}
{# Pagefind's index is generated by `npm run build:prod`, so these 404 during
   `npm run dev`. That is expected: search is a production surface. #}
<link href="/pagefind/pagefind-ui.css" rel="stylesheet">
<script src="/pagefind/pagefind-ui.js"></script>
<script src="/assets/js/search.js"></script>
{% endblock %}
